{
  "openapi": "3.0.3",
  "info": {
    "title": "Medusa API",
    "description": "Medusa API specifications",
    "version": "1.0.0",
    "contact": {
      "name": "HMPPS Digital Studio",
      "email": "feedback@digital.justice.gov.uk"
    }
  },
  "components": {
    "schemas": {
      "CreateCartRequest": {
        "type": "object",
        "required": [
          "metadata"
        ],
        "properties": {
          "metadata": {
            "$ref": "#/components/schemas/CartMetadata"
          }
        }
      },
      "CartMetadata": {
        "type": "object",
        "required": [
          "prison_id",
          "offender_no"
        ],
        "properties": {
          "prison_id": {
            "type": "string",
            "description": "The prison identifier",
            "example": "MDI"
          },
          "offender_no": {
            "type": "string",
            "description": "The prisoner's offender number",
            "example": "A1234BC"
          }
        }
      },
      "AddItemsRequest": {
        "type": "object",
        "required": [
          "amount"
        ],
        "properties": {
          "amount": {
            "type": "integer",
            "format": "int64",
            "description": "Amount in pence",
            "example": 1000
          }
        }
      },
      "CartResponse": {
        "type": "object",
        "properties": {
          "cart": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "The cart ID",
                "example": "cart_1234567890"
              }
            }
          }
        }
      },
      "PaymentRequest": {
        "type": "object",
        "required": [
          "amountPence",
          "offenderNo",
          "prisonId"
        ],
        "properties": {
          "amountPence": {
            "type": "integer",
            "format": "int64",
            "description": "Amount in pence",
            "example": 1000
          },
          "offenderNo": {
            "type": "string",
            "description": "The prisoner's offender number",
            "example": "A1234BC"
          },
          "prisonId": {
            "type": "string",
            "description": "The prisoner's prison number",
            "example": "ASI"
          },
          "paymentStatus": {
            "type": "string",
            "enum": [
              "AUTHORIZED",
              "ERROR"
            ],
            "description": "Payment authorisation status",
            "example": "AUTHORIZED"
          },
          "financeTransactionReference": {
            "type": "string",
            "description": "Transaction reference from release hold create transaction",
            "example": "TXN-2024-00001"
          },
          "financeHoldNumber": {
            "type": "integer",
            "format": "int64",
            "description": "The finance hold number",
            "example": 12345
          },
          "btCreditReference": {
            "type": "string",
            "description": "BT add credit reference",
            "example": "TXN-2024-00001"
          },
          "btCreditLimitPence": {
            "type": "integer",
            "description": "BT credit limit in pence",
            "example": 1000
          },
          "btPreBalancePence": {
            "type": "integer",
            "description": "BT balance pre balance change in pence",
            "example": 1000
          },
          "btNewBalancePence": {
            "type": "integer",
            "description": "BT updated balance",
            "example": 1000
          },
          "errorCode": {
            "type": "string",
            "description": "Error code when payment failed",
            "enum": [
              "HOLD_FAILED",
              "BT_PAYMENT_FAILED",
              "RELEASE_HOLD_CREATE_TRANSACTION_FAILED",
              "RELEASE_HOLD_FAILED"
            ]
          },
          "errorMessage": {
            "type": "string",
            "description": "Error message if payment failed",
            "example": "Insufficient funds on prisoner account"
          }
        }
      },
      "CompleteCartResponse": {
        "type": "object",
        "required": [
          "paymentSuccessful"
        ],
        "properties": {
          "paymentSuccessful": {
            "type": "boolean",
            "description": "Indicates successful payment"
          },
          "orderStatusRecorded": {
            "type": "boolean",
            "description": "Indicates whether medusa was able to complete cart and record order"
          },
          "orderId": {
            "type": "string",
            "description": "The order id within medusa"
          },
          "cartId": {
            "type": "string",
            "description": "The cart ID"
          }
        }
      },
      "SarAccessRequest": {
        "type": "object",
        "required": [
          "prisonerId"
        ],
        "properties": {
          "prisonerId": {
            "type": "string",
            "description": "The prisoner's offender number",
            "example": "G3682UE"
          },
          "fromDate": {
            "type": "string",
            "format": "date",
            "description": "The start date of the SAR request",
            "example": "2026-01-01"
          },
          "toDate": {
            "type": "string",
            "format": "date",
            "description": "The end date of the SAR request",
            "example": "2026-12-31"
          }
        }
      },
      "SarRequestResponse": {
        "type": "object",
        "properties": {
          "sarContent": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SarRequestContent"
            }
          }
        }
      },
      "SarRequestContent": {
        "type": "object",
        "properties": {
          "prisonCode": {
            "type": "string",
            "description": "Prison code",
            "example": "CKI"
          },
          "orderStatus": {
            "type": "string",
            "description": "Order outcome",
            "enum": [
              "completed",
              "failed"
            ],
            "example": "completed"
          },
          "orderCreatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the cart was created"
          },
          "orderUpdatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the cart was last updated"
          },
          "amountInPounds": {
            "type": "string",
            "description": "Payment amount in pounds",
            "example": "5.00"
          },
          "rawAmount": {
            "type": "string",
            "description": "Raw amount with precision",
            "example": "value : 0.01, precision : 20"
          },
          "paymentStatus": {
            "type": "string",
            "description": "Payment session status",
            "enum": [
              "AUTHORIZED",
              "ERROR"
            ],
            "example": "AUTHORIZED"
          },
          "paymentAuthorizedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When payment was authorized"
          },
          "paymentCreatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When payment session was created"
          },
          "paymentUpdatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When payment session was last updated"
          },
          "amountInPence": {
            "type": "string",
            "description": "Payment amount in pence",
            "example": "500"
          },
          "paymentOutcome": {
            "type": "string",
            "description": "BT payment outcome",
            "enum": [
              "AUTHORIZED",
              "ERROR"
            ],
            "example": "AUTHORIZED"
          },
          "btCreditLimit": {
            "type": "string",
            "description": "BT credit limit in pence",
            "example": "50000"
          },
          "btBalanceBeforeTransaction": {
            "type": "string",
            "description": "BT balance before transaction in pence",
            "example": "1000"
          },
          "btBalanceAfterTransaction": {
            "type": "string",
            "description": "BT balance after transaction in pence",
            "example": "1500"
          },
          "errorCode": {
            "type": "string",
            "nullable": true,
            "description": "Error code if payment failed",
            "example": "BT_PAYMENT_FAILED"
          },
          "errorDescription": {
            "type": "string",
            "nullable": true,
            "description": "Error message if payment failed",
            "example": "Insufficient funds on prisoner account"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "integer",
            "example": 500
          },
          "errorCode": {
            "type": "string"
          },
          "userMessage": {
            "type": "string"
          },
          "developerMessage": {
            "type": "string"
          },
          "moreInfo": {
            "type": "string"
          }
        }
      }
    }
  },
  "paths": {
    "/internal/pin-phone/subject-access-request": {
      "get": {
        "operationId": "SarAccessRequest",
        "summary": "Get SAR report information for a given prisoner",
        "description": "Returns all payment session data associated with the prisoner, covering both successful and unsuccessful transactions.\n",
        "parameters": [
          {
            "in": "query",
            "name": "prisonerId",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The prisoner's offender number",
            "example": "G3682UE"
          },
          {
            "in": "query",
            "name": "fromDate",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Lower bound for order dates (inclusive)",
            "example": "2026-01-01"
          },
          {
            "in": "query",
            "name": "toDate",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Upper bound for order dates (inclusive)",
            "example": "2026-12-31"
          }
        ],
        "responses": {
          "200": {
            "description": "SAR data returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SarRequestResponse"
                }
              }
            }
          },
          "500": {
            "description": "Failed to generate SAR information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/internal/pin-phone/carts": {
      "post": {
        "operationId": "createPinPhoneCart",
        "summary": "Create a PIN phone cart",
        "description": "Creates a new cart for a prisoner's PIN phone purchase. If the prisoner has used the service before, the cart is linked to their existing customer record. Otherwise, a new customer and prisoner record are created and linked.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCartRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cart created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CartResponse"
                }
              }
            }
          },
          "404": {
            "description": "Region not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Failed to create cart",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/internal/pin-phone/carts/{id}/complete": {
      "post": {
        "operationId": "completePinPhoneCart",
        "summary": "Complete a PIN phone cart",
        "description": "Completes a PIN phone cart by creating a payment collection, payment session with the BT payment result, and running the cart completion workflow.\n",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The cart ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cart completed or payment failure recorded",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/CompleteCartResponse"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid request — missing or invalid payload, or empty cart",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Cart not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal error during payment collection or session creation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/internal/pin-phone/carts/{id}/add-items": {
      "post": {
        "operationId": "addPinPhoneToCart",
        "summary": "Add PIN phone credit to cart",
        "description": "Adds a PIN phone credit item to the specified cart with the given amount.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The cart ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddItemsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Item added to cart successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CartResponse"
                }
              }
            }
          },
          "404": {
            "description": "PIN Phone variant not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Failed to add pin phone to cart",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "tags": []
}