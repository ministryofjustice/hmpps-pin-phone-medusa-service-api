{
  "name": "hmpps-digital-canteen-medusa-service",
  "private": false,
  "packageManager": "npm@11.8.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "cd backend && npm run dev",
    "build": "cd backend && npm run build",
    "start": "cd backend && npm run start",
    "test": "cd backend && npm run test:unit",
    "seed": "npm run seed --workspace=@dtc/backend",
    "lint": "eslint . --cache --max-warnings 0",
    "lint-fix": "eslint . --cache --max-warnings 0 --fix",
    "setup": "npm ci && cd backend && npm run setup",
    "typecheck": "cd backend && npx tsc --noEmit"
  },
  "devDependencies": {
    "@ministryofjustice/eslint-config-hmpps": "^1.0.3",
    "lint-staged": "^17.0.7",
    "prettier": "^3.2.5"
  },
  "dependencies": {
    "pre-commit": "^2.0.0"
  },
  "overrides": {
    "brace-expansion": ">=5.0.7"
  }

}
